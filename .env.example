# Supabase project credentials (required for Supabase mode)
# Copy to .env.local (dev) or .env.staging (staging) and fill in values
# from your Supabase project Settings → API page.
#
# Environment tiers:
#   .env.local         → local Supabase instance (supabase start)
#   .env.staging       → protocode-chat-staging Supabase project
#   CI secrets         → production Supabase project (set in GitHub/Netlify/Vercel)
#
# Missing VITE_SUPABASE_URL → app runs in local-only (localStorage) mode.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
